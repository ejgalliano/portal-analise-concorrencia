# Copie este arquivo para ".env" e preencha com valores reais.
# Nunca faça commit do ".env" de verdade em nenhum repositório.

# Chave da API da Anthropic — console.anthropic.com / platform.claude.com
# Precisa ter a ferramenta "Web search" habilitada na conta.
ANTHROPIC_API_KEY=

# Modelo usado para pesquisar e redigir o relatório
ANTHROPIC_MODEL=claude-opus-5

# Conta na Resend (resend.com) — envio do relatório por e-mail
RESEND_API_KEY=
EMAIL_REMETENTE=relatorios@seu-dominio.com.br
EMAIL_NOME_REMETENTE=Portal de Análise de Concorrência

# Textos usados no relatório e nos e-mails
NOME_PRODUTO=Portal de Análise de Concorrência
NOME_AGENCIA=VMAI

# Onde os pedidos (JSON + PDF gerado) ficam salvos
ORDERS_DIR=orders

# Mercado Pago (Checkout Pro) — dashboard.mercadopago.com.br > Suas integrações
# Use as credenciais de TESTE (Access Token de teste) enquanto estiver testando
# localmente; troque para as de produção só quando for cobrar de verdade.
MERCADOPAGO_ACCESS_TOKEN=

# Preço do relatório em centavos (1990 = R$ 19,90) — valor simbólico sugerido
# para a rodada de teste com amigos; ajuste livremente.
PRECO_RELATORIO_CENTAVOS=1990
